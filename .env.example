# ============================================================================
# FretConnect CI - Environment Variables (Supabase & Local Dev)
# ============================================================================

# Supabase PostgreSQL Connection String (Pooler or Direct)
# Ex: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Ou Direct: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-supabase-password@db.your-project.supabase.co:5432/postgres

# Supabase API Configuration (Pour le mobile et backend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server Port
PORT=5000
NODE_ENV=development

